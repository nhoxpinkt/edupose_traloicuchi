name: Build and Deploy Vite App to GitHub Pages

on:
  # Tự động chạy mỗi khi cập nhật mã nguồn lên nhánh main
  push:
    branches: ['main']
  # Cho phép kích hoạt thủ công trong tab Actions của GitHub
  workflow_dispatch:

# Quyền cần thiết để GitHub Actions triển khai lên GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Chỉ cho phép 1 lượt deploy chạy đồng thời, không hủy lượt đang triển khai
concurrency:
  group: 'pages'
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout mã nguồn
        uses: actions/checkout@v4

      - name: Thiết lập Node.js 22
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Cấu hình GitHub Pages
        id: pages
        uses: actions/configure-pages@v5

      - name: Cài đặt thư viện
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install --no-audit --no-fund
          fi

      - name: Build ứng dụng Vite
        run: npm run build

      - name: Đảm bảo file .nojekyll tồn tại trong dist
        run: touch dist/.nojekyll

      - name: Đóng gói artifact cho GitHub Pages
        uses: actions/upload-pages-artifact@v3
        with:
          path: './dist'

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Triển khai lên GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
